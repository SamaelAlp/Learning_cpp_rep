#include "file_log_sink.hpp"

#include <gtest/gtest.h>

#include <filesystem>
#include <fstream>
#include <sstream>
#include <string>

using namespace chat;

namespace fs = std::filesystem;

class FileLogSinkTest : public ::testing::Test {
protected:
    void SetUp() override {
        test_file_ = fs::temp_directory_path() / "test_log.txt";
        fs::remove(test_file_);
    }

    void TearDown() override {
        fs::remove(test_file_);
    }

    fs::path test_file_;
};

TEST_F(FileLogSinkTest, CreatesFileOnConstruction) {
    {
        FileLogSink log(test_file_);
    }
    EXPECT_TRUE(fs::exists(test_file_));
}

TEST_F(FileLogSinkTest, ThrowsIfFileCannotBeOpened) {
    fs::path invalid_path = "/nonexistent/directory/log.txt";
    EXPECT_THROW(FileLogSink log(invalid_path), std::runtime_error);
}

TEST_F(FileLogSinkTest, AppendsLines) {
    {
        FileLogSink log(test_file_);
        log.append("line 1");
        log.append("line 2");
    }

    std::ifstream file(test_file_);
    std::string line1, line2;
    std::getline(file, line1);
    std::getline(file, line2);

    EXPECT_EQ(line1, "line 1");
    EXPECT_EQ(line2, "line 2");
}

TEST_F(FileLogSinkTest, ClosesOnDestruction) {
    {
        FileLogSink log(test_file_);
        log.append("test");
    }
    std::ifstream file(test_file_);
    EXPECT_TRUE(file.good());
}

TEST_F(FileLogSinkTest, ClosesOnException) {
    try {
        FileLogSink log(test_file_);
        log.append("before exception");
        throw std::runtime_error("test exception");
    } catch (...) {

    }

    std::ifstream file(test_file_);
    std::string line;
    std::getline(file, line);
    EXPECT_EQ(line, "before exception");
}

TEST_F(FileLogSinkTest, MoveTransfersOwnership) {
    FileLogSink log1(test_file_);
    log1.append("from log1");

    FileLogSink log2 = std::move(log1);
    log2.append("from log2");

    std::ifstream file(test_file_);
    std::string line1, line2;
    std::getline(file, line1);
    std::getline(file, line2);

    EXPECT_EQ(line1, "from log1");
    EXPECT_EQ(line2, "from log2");
}